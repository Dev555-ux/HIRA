# Copy this file to .env and fill in real values. .env is git-ignored.
# Local dev uses the Postgres + pgvector container (see documentation/DATABASE.md).
# REQUIRED — the only setting with no default; the app/Alembic won't start
# without it. In Railway this is set on the service's Variables tab, not here.
# Railway/most managed Postgres providers hand out `postgres://` or bare
# `postgresql://` (no driver) — app/core/config.py normalizes either to
# `postgresql+psycopg://` automatically, so either form works.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/hira

# Which environment this process is running as. Leave unset locally (defaults
# to "development"). The deployed Railway service MUST set this to
# "production" — it's what makes app/core/config.py refuse to start if the
# WhatsApp secrets below are still their insecure dev defaults (SEC-1).
ENVIRONMENT=development

# WhatsApp / Meta Cloud API (real values from Meta; dev defaults exist in code).
# VERIFY_TOKEN: any string you choose; enter the same value in Meta's webhook setup.
# APP_SECRET:   Meta App → Settings → Basic → App Secret (used to verify signatures).
# ACCESS_TOKEN: Meta → WhatsApp → API Setup (temporary) or a System User token (permanent).
# Note: the sender phone number id is stored per-business (businesses.whatsapp_phone_number_id),
# resolved from the inbound webhook metadata — there is no global PHONE_NUMBER_ID.
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret
WHATSAPP_ACCESS_TOKEN=dev-access-token
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0

# LLM provider: mock (default, no key) | groq | claude
LLM_PROVIDER=mock
# Groq (official groq SDK). Model ids look like "llama-3.3-70b-versatile".
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Claude (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Max tokens per LLM response. Rarely needs changing.
LLM_MAX_TOKENS=1024

# Embeddings for knowledge-base retrieval. Only "local_bge" exists today (a
# local BAAI/bge-small-en-v1.5 model, no API key/cost) — these rarely need
# changing, included here for completeness.
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Clerk auth (dashboard). From the Clerk dashboard → API keys / JWT.
CLERK_JWKS_URL=
CLERK_ISSUER=
# Dev-only: accept a fixed mock token ("dev-mock-token", same one the frontend
# sends when it has no Clerk key) in place of real Clerk verification, when
# CLERK_JWKS_URL above is blank. Leave unset/false normally; NEVER set true in
# production — with Clerk unconfigured and this unset, requests correctly fail
# with 500 instead of being silently treated as authenticated.
ALLOW_MOCK_AUTH=false

# Google Calendar (Sprint 29, DEC-032). From a Google Cloud project → APIs &
# Services → Credentials → OAuth client ID (type: Web application), with the
# Calendar API enabled. REDIRECT_URI must exactly match one of the client's
# "Authorized redirect URIs" (e.g. http://localhost:8000/api/v1/calendar/oauth/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
# Fernet key encrypting stored refresh tokens at rest, and HMAC-signing the
# OAuth `state` param. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every already-stored refresh token (businesses
# would need to reconnect) — treat it like DATABASE_URL, not like an API key.
CALENDAR_ENCRYPTION_KEY=

# Where the frontend is deployed. Used for the Google OAuth callback's browser
# redirect, and (Sprint 34) included in main.py's CORS allow_origins — set
# this to the real deployed frontend domain in production, or the dashboard
# will be CORS-blocked from calling this API at all.
FRONTEND_URL=http://localhost:3000

# Error monitoring (Sprint 52B, Task 3). From sentry.io → Settings → Projects
# → [project] → Client Keys (DSN). Leave blank locally — the SDK is a no-op
# without a DSN, so nothing needs disabling separately for dev.
SENTRY_DSN=

# Rate limits (Sprint 52B, Task 1) — "<count>/<second|minute|hour|day>".
# Business-scoped where a business exists yet, else IP-scoped. Defaults are
# sized for a small beta; revisit before a wider launch.
RATE_LIMIT_DEMO_CHAT=20/minute
RATE_LIMIT_KB_UPLOAD=10/minute
RATE_LIMIT_BUSINESS_CREATION=5/hour

# Webhook health monitoring (Sprint 69). How long WhatsApp inbound traffic
# can go quiet before GET /health/whatsapp flips unhealthy and raises a
# Sentry alert (a no-op without SENTRY_DSN above). See documentation/DEPLOYMENT.md.
WEBHOOK_STALE_THRESHOLD_MINUTES=60
