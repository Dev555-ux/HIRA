# Copy this file to .env and fill in real values. .env is git-ignored.
# Local dev uses the Postgres + pgvector container (see documentation/DATABASE.md).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/hira

# WhatsApp / Meta Cloud API (real values from Meta; dev defaults exist in code).
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret

# LLM provider: mock (default, no key) | openrouter | claude
LLM_PROVIDER=mock
# OpenRouter (OpenAI-compatible). Model ids look like "openai/gpt-4o-mini".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Claude (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
