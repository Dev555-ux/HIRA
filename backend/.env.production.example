# Copy to .env on the EC2 instance (chmod 600, never commit it — same
# .gitignore rule as backend/.env.example). Used by both docker-compose.prod
# .yml (env_file: .env, shared by the api/worker services) and the nginx
# service (API_DOMAIN only). See documentation/DEPLOYMENT_AWS.md for the
# full deploy runbook this file supports.
#
# This mirrors backend/.env.example (the local-dev template) — same
# variables, same defaults where they apply. Only the deploy-target-specific
# notes differ below; consult .env.example for anything not called out here.

# ── Postgres container (docker-compose.prod.yml's `postgres` service) ──────
# These three configure the containerized Postgres itself. DATABASE_URL below
# MUST be built from the same user/password/db — they are not read
# automatically from each other.
POSTGRES_USER=hira
POSTGRES_PASSWORD=CHANGE_ME_generate_a_real_random_password
POSTGRES_DB=hira

# `postgres` here is the Docker Compose service name (api/worker resolve it
# via the compose network's internal DNS) — not a Railway-injected value
# anymore. Must match POSTGRES_USER/PASSWORD/DB above exactly.
DATABASE_URL=postgresql+psycopg://hira:CHANGE_ME_generate_a_real_random_password@postgres:5432/hira

# REQUIRED — must be "production" (activates the SEC-1 insecure-default boot
# guard in app/core/config.py, same as it did on Railway).
ENVIRONMENT=production

# ── WhatsApp / Meta Cloud API (real values from Meta) ───────────────────────
# Sprint 82 removed WHATSAPP_APP_SECRET/WHATSAPP_ACCESS_TOKEN: credentials are
# per-business (encrypted in whatsapp_credentials) and nothing read the global
# pair. Existing deployments can leave them set; they are ignored.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0

# ── Meta Tech Provider (Sprint 82) ─────────────────────────────────────────
# Stoneveil's own Meta App. META_APP_SECRET verifies webhooks for Embedded
# Signup customers; without it those deliveries are rejected (fail closed).
# Optional: a deployment serving only guided-manual customers boots without
# them and keeps working exactly as before.
META_APP_ID=
META_APP_SECRET=
META_APP_CONFIG_ID=

# The WhatsApp connect wizard's displayed callback URL (GET
# /api/v1/whatsapp/webhook-config). Railway auto-injected this; on EC2 there
# is no equivalent auto-injection, so set it by hand to the same domain
# nginx/nginx.conf's API_DOMAIN below points at. Leaving it blank still works
# (the wizard falls back to the incoming request's own host) but setting it
# avoids relying on that fallback.
RAILWAY_PUBLIC_DOMAIN=

# ── LLM provider: mock (default, no key) | groq | claude ────────────────────
# Backend REFUSES TO BOOT with ENVIRONMENT=production if this is still "mock".
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024

# ── Embeddings (local model, baked into the Docker image at build time) ────
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Clerk auth (dashboard) — must be a *production* Clerk instance, not the
# default Development instance (see documentation/DEPLOYMENT_AWS.md) ───────
CLERK_JWKS_URL=
CLERK_ISSUER=
ALLOW_MOCK_AUTH=false

# Comma-separated Clerk user ids allowed into the Founder Operations
# Dashboard (GET /api/v1/founder/*).
FOUNDER_CLERK_USER_IDS=

# ── Google Calendar (optional — only if Calendar is connected for the pilot
# business) ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://CHANGE_ME_api_domain/api/v1/calendar/oauth/callback

# REQUIRED regardless of Calendar usage — also encrypts self-serve WhatsApp
# credentials (app/whatsapp/security.py). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_ENCRYPTION_KEY=

# Real deployed Vercel frontend URL — required for CORS (app/main.py).
FRONTEND_URL=

# Free-tier is enough for a beta.
SENTRY_DSN=

RATE_LIMIT_DEMO_CHAT=20/minute
RATE_LIMIT_KB_UPLOAD=10/minute
RATE_LIMIT_BUSINESS_CREATION=5/hour

WEBHOOK_STALE_THRESHOLD_MINUTES=60

# v0.10.0 transactional outbox — set true on BOTH api and worker only after
# the worker service is confirmed running (docker-compose.prod.yml starts
# both together, so this is safe to leave true from the first deploy here,
# unlike the staged Railway rollout in documentation/DEPLOYMENT.md).
USE_TRANSACTIONAL_OUTBOX=true
OUTBOX_WORKER_POLL_INTERVAL=0.5
OUTBOX_WORKER_BATCH_SIZE=5
OUTBOX_ZOMBIE_TIMEOUT_SECONDS=300
OUTBOX_BACKOFF_BASE_SECONDS=2.0
OUTBOX_BACKOFF_MAX_SECONDS=3600.0

# ── Nginx (docker-compose.prod.yml's `nginx` service only) ─────────────────
# The domain Certbot issues the TLS cert for and nginx/nginx.conf serves —
# must already point at this instance's Elastic IP via DNS before running
# certbot (documentation/DEPLOYMENT_AWS.md's bootstrap steps).
API_DOMAIN=CHANGE_ME_api_domain
