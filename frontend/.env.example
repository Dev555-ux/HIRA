# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk (leave blank in dev to use mocked auth; REQUIRED in production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Tells Clerk's redirect helpers (auth.protect(), <UserButton>, etc.) to use
# our own pages instead of falling back to a Clerk-hosted account portal URL.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# WhatsApp Embedded Signup (Track B prep, TODOS.md ONBOARD-E). OFF until Meta
# Tech Provider approval exists — leave both unset/false until then. Must
# match the backend's ENABLE_EMBEDDED_SIGNUP/META_APP_ID/META_APP_CONFIG_ID.
# Both values below are public (they ship to the browser in Meta's JS SDK
# call); META_APP_SECRET is backend-only and has no NEXT_PUBLIC_ counterpart.
NEXT_PUBLIC_ENABLE_EMBEDDED_SIGNUP=false
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_META_APP_CONFIG_ID=
