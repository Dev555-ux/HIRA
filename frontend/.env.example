# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk (leave blank in dev to use mocked auth; REQUIRED in production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Tells Clerk's redirect helpers (auth.protect(), <UserButton>, etc.) to use
# our own pages instead of falling back to a Clerk-hosted account portal URL.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
